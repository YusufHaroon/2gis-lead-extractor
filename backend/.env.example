# Copy to backend/.env and adjust. All values are optional; these are the defaults.

# Source used when a request doesn't name one: mock | local_fixture | twogis
DEFAULT_COLLECTOR=mock

# The live 2GIS collector stays disabled unless collection, storage and lead-generation
# export are authorized. It uses the official 2GIS Catalog API (no scraping, no CAPTCHA).
# It appears in the dashboard only when this is true AND TWOGIS_API_KEY is set.
ENABLE_LIVE_COLLECTOR=false

# 2GIS Catalog API key (kept server-side; never sent to the browser).
# The key must be licensed for contact data, or phone numbers come back blank.
TWOGIS_API_KEY=
# Optional: pin a region id (skips the region lookup). Otherwise resolved from the location.
TWOGIS_REGION_ID=
# API base URL (default is the global Catalog API host).
TWOGIS_API_BASE=https://catalog.api.2gis.com

# Hard cap on results per search; requests above it are clamped.
MAX_RESULTS_CAP=200

# A search that runs longer than this fails (results collected so far are kept).
COLLECTOR_TIMEOUT_SECONDS=120

# Searches allowed to run at the same time; extra requests get HTTP 429.
MAX_CONCURRENT_JOBS=3

# Comma-separated browser origins allowed to call the API (the dashboard's URL).
CORS_ORIGINS=http://localhost:3000
